Route25_Frlg_MapScripts::
	.byte 0

Route25_EventScript_SeaCottageSign::
	msgbox Route25_Text_SeaCottageSign, MSGBOX_SIGN
	end

Route25_EventScript_Man::
	msgbox Route25_Text_AreYouHereAlone, MSGBOX_NPC
	end

Route25_Text_JoeyIntro::
	.string "I found a loot bag yesterday!\p"
	.string "Wanna fight for it?$"

Route25_Text_JoeyDefeat::
	.string "Aww… There goes my lunch money.$"

Route25_Text_JoeyPostBattle::
	.string "Don't tell my mom I battled you.$"

Route25_Text_DanIntro::
	.string "My POKéMON is the scariest on the\n"
	.string "block!$"

Route25_Text_DanDefeat::
	.string "Okay, okay! You win!$"

Route25_Text_DanPostBattle::
	.string "Can I join your crew when I'm\n"
	.string "older?$"

Route25_Text_FlintIntro::
	.string "I'm the toughest kid on this road.\n"
	.string "Ask anyone!$"

Route25_Text_FlintDefeat::
	.string "Okay, okay! You win!$"

Route25_Text_FlintPostBattle::
	.string "The road to CERULEAN isn't safe.\p"
	.string "Watch out!$"

Route25_Text_KelseyIntro::
	.string "GUZMA says kids can't fight. I'll\n"
	.string "prove him wrong!$"

Route25_Text_KelseyDefeat::
	.string "No fair! You're way too strong!$"

Route25_Text_KelseyPostBattle::
	.string "Everybody's scared of GUZMA.\p"
	.string "Are you scared?$"

Route25_Text_ChadIntro::
	.string "My big brother rides with TEAM\n"
	.string "SKULL! I'm gonna be just like him!$"

Route25_Text_ChadDefeat::
	.string "Waaah! I'm telling my brother!$"

Route25_Text_ChadPostBattle::
	.string "When I grow up, I'm joining TEAM\n"
	.string "SKULL.\p"
	.string "Or maybe your crew!$"

Route25_Text_HaleyIntro::
	.string "Mom says stay inside.\p"
	.string "But battles are way more fun!$"

Route25_Text_HaleyDefeat::
	.string "Aww… There goes my lunch money.$"

Route25_Text_HaleyPostBattle::
	.string "I hide when the gangs come by.\p"
	.string "Not from you, though!$"

Route25_Text_FranklinIntro::
	.string "These hills are older than any\n"
	.string "gang.\p"
	.string "So am I!$"

Route25_Text_FranklinDefeat::
	.string "Whoa! Rolled right over me!$"

Route25_Text_FranklinPostBattle::
	.string "Head to CERULEAN if you want\n"
	.string "trouble.$"

Route25_Text_NobIntro::
	.string "Out here, nobody pays the tolls of\n"
	.string "GUZMA!$"

Route25_Text_NobDefeat::
	.string "My birds flew off…$"

Route25_Text_NobPostBattle::
	.string "Rest a bit. The road ahead is\n"
	.string "rough.$"

Route25_Text_WayneIntro::
	.string "Gangs come and go. The mountains\n"
	.string "stay!$"

Route25_Text_WayneDefeat::
	.string "Like a rockslide!$"

Route25_Text_WaynePostBattle::
	.string "Gangs never climb this far. Too\n"
	.string "lazy.$"

Route25_Text_SeaCottageSign::
	.string "SEA COTTAGE\n"
	.string "BILL lives here!$"

Route25_Text_MistyHighHopesAboutThisPlace::
	.string "This cape used to be a famous\n"
	.string "date spot.\p"
	.string "Now TEAM SKULL throws parties\n"
	.string "here.$"

Route25_Text_AreYouHereAlone::
	.string "Are you here alone?\p"
	.string "Out on CERULEAN's cape, you'd\n"
	.string "better bring your crew.$"

