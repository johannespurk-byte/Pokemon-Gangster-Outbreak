@ Gangster Outbreak: HEAL-BOTs and SHOP-BOTs on the routes, in Viridian Forest and on the Sevii Islands.
@ Generated by tools/apocalypse/route_bots.py - edit the offers there.

GangRouteBot_EventScript_Heal::
	lock
	faceplayer
	msgbox GangRouteBot_Text_HealOffer, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, GangRouteBot_EventScript_HealBye
	message GangRouteBot_Text_Healing
	waitmessage
	playfanfare MUS_HEAL
	waitfanfare
	special HealPlayerParty
	special GangItems_Recharge
	msgbox GangRouteBot_Text_HealDone
	release
	end

GangRouteBot_EventScript_HealBye::
	msgbox GangRouteBot_Text_HealBye
	release
	end

GangRouteBot_Text_HealOffer:
	.string "BZZT… FIELD HEAL-BOT.\p"
	.string "Restore POKéMON and recharge\n"
	.string "your gadgets?$"

GangRouteBot_Text_Healing:
	.string "Scanning POKéMON…$"

GangRouteBot_Text_HealDone:
	.string "Treatment complete.\n"
	.string "Stay dangerous out there.$"

GangRouteBot_Text_HealBye:
	.string "HEAL-BOT returning to standby.$"

GangRouteBot_Text_ShopHello:
	.string "KLONK! FIELD SHOP-BOT.\p"
	.string "Special offer for this area.\n"
	.string "Insert money. Choose product.$"

